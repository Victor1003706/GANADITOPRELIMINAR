{
  "name": "@ganadito/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API de Ganadito (Node.js + Fastify + TypeScript)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc",
    "seed": "tsx src/seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.6",
    "@fastify/websocket": "^11.3.4",
    "@ganadito/contracts": "*",
    "@ganadito/shared": "*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2"
  }
}
