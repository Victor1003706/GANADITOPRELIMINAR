# ==============================================================================
# GANADITO — Variables de Entorno de Ejemplo (DESARROLLO LOCAL)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env: cp .env.example .env
# 2. Reemplaza los valores necesarios para tu entorno local.
# 3. NUNCA subas archivos .env al repositorio Git.
# ==============================================================================

# Entorno general
NODE_ENV=development
APP_PORT=3000
API_PORT=4000
API_HOST=127.0.0.1
# Arranque seguro: confirmar destino y migraciones con Nicolás antes de activarlos.
RUN_MIGRATIONS_ON_START=false
START_WORKERS=false

# PostgreSQL + PostGIS (Base de datos transaccional principal)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ganadito_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_local_password
DATABASE_URL=postgresql://postgres:postgres_local_password@localhost:5432/ganadito_dev

# Redis (Caché, presencia y mensajería efímera)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Autenticación y Seguridad (Valores ficticios para desarrollo)
JWT_SECRET=super_secret_local_dev_key_change_me_in_real_environments_32_chars_min
SESSION_SECRET=local_session_cookie_secret_key_minimum_32_characters_long

# Pagos desactivados. Estos valores no habilitan cobros ni un proveedor externo.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=SIMULADOR
PAYMENTS_CHECKOUT_BASE_URL=
WEBHOOK_SECRET=

# URLs de servicios
# REST por el proxy web del mismo origen (vacío evita necesitar CORS).
PUBLIC_API_URL=
# Destino privado del proxy REST. Nunca se envía al navegador.
API_INTERNAL_URL=http://127.0.0.1:4000
# Vacío en local: Vite reenvía WebSocket. En staging configurar wss://host-api
# o usar el reverse proxy documentado en infrastructure/deployment.
PUBLIC_WS_URL=
# Desactivado hasta resolver la exposición del token WS; usa snapshots HTTP oficiales.
PUBLIC_LIVE_AUCTIONS_ENABLED=false
# La demo comercial está separada de la app conectada a API. Se activa solo con `npm run demo`.
PUBLIC_DEMO_ENABLED=false
PUBLIC_WEB_URL=http://127.0.0.1:3000
GANADITO_RELEASE_SHA=development

# Servicio de IA (Python - Fase posterior)
AI_SERVICE_URL=http://localhost:8000
